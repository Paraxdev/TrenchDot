{
  "format": "trenchdot-mcp-script",
  "vars": {"save_dir": "${project}/demo/maps/showcase", "data_directory": "res://terrain3d_valley"},
  "title": "Terrain3D Valley",
  "description": "A river valley on a Terrain3D landscape of 3 x 2 regions of 256 m, built the way the Terrain3D page in the docs does it: a new data folder linked from TrenchDot, ridges, foothills and a winding river bed sculpted with terrain_edit, cliff, sand and dirt painted by Terrain3D texture id, a village and a bridge from TrenchDot brushes standing on the ground, and two scatter sets that follow the Terrain3D surface. Godot applies the pending regions when the map is saved, so run it in a project that does not have the data folder yet. The project needs Terrain3D, Godot found and the project trusted, the showcase materials of the demo project, and the glTF nature pack from Godot > Add Content to Project, without which the mixed woodland set fails and so do the five tree steps after it. The paint uses texture ids 0 grass, 1 cliff, 2 dirt and 3 sand. The ground is Terrain3D's checkerboard until the Terrain3D node has those texture assets, add them in Godot after the first save, the way res://terrain3d_valley/terrain3d_assets.tres of the demo project does.",
  "steps": [
    {"tool": "map_file", "args": {"op": "new"}},
    {"tool": "set_map_properties", "args": {"properties": {"message": "Terrain3D Valley", "sun_angles": "-38 -140", "sun_color": "255 238 214", "sun_energy": "1.15", "ambient_color": "110 124 150", "sky_top_color": "76 128 200", "sky_horizon_color": "208 222 234", "sky_ground_color": "70 98 122", "fog_color": "198 214 228", "fog_density": "0.00008"}}},
    {"note": "The landscape is a Terrain3D node: a new folder of 3 x 2 regions of 256 m at a vertex spacing of 1 m, so the ground is 768 x 512 m, from x -8192 to 16384 and z -8192 to 8192 in map units. Godot is the only one that writes the region files, the edits below wait as pending files until it applies them."}
,
    {"tool": "terrain3d", "args": {"op": "link", "data_directory": "${data_directory}", "create": {"region_size": 256, "vertex_spacing": 1, "columns": 3, "rows": 2}}, "save": "land"},
    {"note": "Ridges: a high ridge along the north side and a lower one in the south, with a few peaks on top. The strength is the height the brush adds, in map units (32 per meter)."}
,
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt_path", "mode": "raise", "points": [[-7800, -6400], [-3800, -5600], [200, -6600], [4600, -5800], [9000, -6600], [13200, -5600], [16200, -6400]], "radius": 3200, "strength": 560}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt_path", "mode": "raise", "points": [[-7800, 6600], [-2600, 6000], [2600, 6800], [7600, 6100], [12600, 6700], [16200, 6000]], "radius": 3000, "strength": 380}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [-1800, -6200], "radius": 1800, "strength": 450}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [5200, -6500], "radius": 2000, "strength": 550}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [11200, -6200], "radius": 1700, "strength": 400}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [2000, 6600], "radius": 1700, "strength": 300}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [9600, 6500], "radius": 1900, "strength": 350}},
    {"note": "Rolling foothills on the valley floor, then a smoothing pass so the slopes have no steps."}
,
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [-3000, -2400], "radius": 2200, "strength": 260}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [8800, 2600], "radius": 2400, "strength": 300}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [13600, -2200], "radius": 2000, "strength": 240}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt", "mode": "raise", "center": [-5200, 3000], "radius": 2000, "strength": 220}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt_path", "mode": "smooth", "points": [[-7000, -3000], [-2000, -3000], [4000, -3000], [10000, -3000], [15000, -3000], [15000, 3000], [10000, 3000], [4000, 3000], [-2000, 3000], [-7000, 3000]], "radius": 2600, "strength": 1}},
    {"note": "The river bed follows a winding path along the valley and is cut about 200 units into the floor, straight where the bridge crosses it."}
,
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt_path", "mode": "lower", "points": [[-7600, 1400], [-4000, -600], [-500, 900], [2600, -300], [4800, 0], [7600, 0], [10000, 700], [13000, -700], [16000, 300]], "radius": 520, "strength": 45, "spacing": 120}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "sculpt_path", "mode": "smooth", "points": [[-7600, 1400], [-4000, -600], [-500, 900], [2600, -300], [4800, 0], [7600, 0], [10000, 700], [13000, -700], [16000, 300]], "radius": 760, "strength": 1, "spacing": 200}},
    {"note": "A flat pad for the village on the north bank, and the bridge approaches raised from both banks."}
,
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "flatten_rect", "min": [3000, -2600], "max": [5400, -900], "height": 128, "margin": 600}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "flatten_rect", "min": [5900, -1500], "max": [6500, -560], "height": 40, "margin": 500}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "flatten_rect", "min": [5900, 560], "max": [6500, 1500], "height": 40, "margin": 500}},
    {"note": "Terrain3D texture ids: 0 grass, 1 cliff, 2 dirt, 3 sand. Everything starts as grass, cliff goes over the ridges, sand along the river and dirt on the road."}
,
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "paint_texture", "texture": 1, "mode": "base", "points": [[-7800, -6400], [-3800, -5600], [200, -6600], [4600, -5800], [9000, -6600], [13200, -5600], [16200, -6400]], "radius": 2700}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "paint_texture", "texture": 1, "mode": "base", "points": [[-7800, 6600], [-2600, 6000], [2600, 6800], [7600, 6100], [12600, 6700], [16200, 6000]], "radius": 2300}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "paint_texture", "texture": 3, "mode": "base", "points": [[-7600, 1400], [-4000, -600], [-500, 900], [2600, -300], [4800, 0], [7600, 0], [10000, 700], [13000, -700], [16000, 300]], "radius": 760, "spacing": 120}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "paint_texture", "texture": 2, "mode": "spray", "points": [[-7600, 1400], [-4000, -600], [-500, 900], [2600, -300], [4800, 0], [7600, 0], [10000, 700], [13000, -700], [16000, 300]], "radius": 1000, "spacing": 150, "strength": 0.5}},
    {"tool": "terrain_edit", "args": {"id": "$land.id", "op": "paint_texture", "texture": 2, "mode": "base", "points": [[3600, -1700], [4300, -1100], [5400, -1300], [6200, -1300], [6200, 1300], [7600, 2000], [9600, 2300]], "radius": 170, "spacing": 80}},
    {"note": "The water is one flat brush a little under the valley floor, a func_illusionary so it has no collision. It only shows where the river bed is cut below it."}
,
    {"tool": "create_brush", "args": {"min": [-8192, -64, -8192], "max": [16384, -48, 8192], "material": "showcase/water", "uv_scale": 8, "entity": {"classname": "func_illusionary"}}},
    {"note": "The village: three houses with doors and windows on the pad, a gable roof on each and a chimney, built from TrenchDot brushes that stand on the Terrain3D ground."}
,
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "cottage"}},
    {"tool": "create_brush", "args": {"min": [3300, 120, -2400], "max": [3900, 368, -1800], "material": "showcase/plaster", "hollow": 16, "openings": [[[3470, 128, -1830], [3570, 300, -1790]], [[3680, 200, -1830], [3780, 290, -1790]], [[3270, 200, -2200], [3330, 290, -2100]]]}},
    {"tool": "create_brush", "args": {"shape": "gable", "min": [3300, 368, -2440], "max": [3900, 478, -1760], "material": "showcase/roof_red"}},
    {"tool": "hierarchy", "args": {"op": "close_group", "all": true}},
    {"tool": "create_brush", "args": {"min": [3700, 368, -2300], "max": [3780, 520, -2220], "material": "showcase/stone_bricks"}},
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "farmhouse"}},
    {"tool": "create_brush", "args": {"min": [4300, 120, -2300], "max": [5000, 368, -1700], "material": "showcase/stone_bricks", "hollow": 16, "openings": [[[4500, 128, -1730], [4620, 310, -1670]], [[4760, 200, -1730], [4880, 290, -1670]], [[4290, 200, -2100], [4330, 290, -2000]]]}},
    {"tool": "create_brush", "args": {"shape": "gable", "ridge_x": true, "min": [4260, 368, -2300], "max": [5040, 488, -1700], "material": "showcase/roof_slate"}},
    {"tool": "hierarchy", "args": {"op": "close_group", "all": true}},
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "barn"}},
    {"tool": "create_brush", "args": {"min": [3400, 120, -1300], "max": [3900, 330, -1000], "material": "showcase/planks_dark", "hollow": 16, "openings": [[[3560, 128, -1030], [3740, 290, -970]]]}},
    {"tool": "create_brush", "args": {"shape": "gable", "ridge_x": true, "min": [3360, 330, -1300], "max": [3940, 430, -1000], "material": "showcase/roof_slate"}},
    {"tool": "hierarchy", "args": {"op": "close_group", "all": true}},
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "fence"}},
    {"tool": "create_brush", "args": {"min": [4400, 128, -1010], "max": [4416, 190, -994], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [4530, 128, -1010], "max": [4546, 190, -994], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [4660, 128, -1010], "max": [4676, 190, -994], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [4790, 128, -1010], "max": [4806, 190, -994], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [4920, 128, -1010], "max": [4936, 190, -994], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [5050, 128, -1010], "max": [5066, 190, -994], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [5180, 128, -1010], "max": [5196, 190, -994], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [5310, 128, -1010], "max": [5326, 190, -994], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [4400, 170, -1008], "max": [5430, 184, -996], "material": "showcase/beam"}},
    {"tool": "hierarchy", "args": {"op": "close_group", "all": true}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [3520, 230, -1760], "properties": {"light_energy": "1.0", "light_color": "255 214 160", "omni_range": "6"}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [4560, 250, -1640], "properties": {"light_energy": "1.0", "light_color": "255 214 160", "omni_range": "6"}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [3650, 230, -960], "properties": {"light_energy": "1.0", "light_color": "255 214 160", "omni_range": "6"}}},
    {"tool": "create_entity", "args": {"classname": "info_player_start", "origin": [4000, 136, -700]}},
    {"note": "The bridge over the river: a plank deck on stone abutments with beam posts and rails. The approaches are Terrain3D ground raised to the deck."}
,
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "bridge"}},
    {"tool": "create_brush", "args": {"min": [6040, 24, -760], "max": [6360, 48, 760], "material": "showcase/planks"}},
    {"tool": "create_brush", "args": {"min": [6000, -220, -780], "max": [6400, 48, -640], "material": "showcase/stone_bricks"}},
    {"tool": "create_brush", "args": {"min": [6000, -220, 640], "max": [6400, 48, 780], "material": "showcase/stone_bricks"}},
    {"tool": "create_brush", "args": {"min": [6040, 48, -708], "max": [6056, 128, -692], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6344, 48, -708], "max": [6360, 128, -692], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6040, 48, -358], "max": [6056, 128, -342], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6344, 48, -358], "max": [6360, 128, -342], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6040, 48, -8], "max": [6056, 128, 8], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6344, 48, -8], "max": [6360, 128, 8], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6040, 48, 342], "max": [6056, 128, 358], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6344, 48, 342], "max": [6360, 128, 358], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6040, 48, 692], "max": [6056, 128, 708], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6344, 48, 692], "max": [6360, 128, 708], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6040, 112, -716], "max": [6056, 124, 716], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [6344, 112, -716], "max": [6360, 124, 716], "material": "showcase/beam"}},
    {"tool": "hierarchy", "args": {"op": "close_group", "all": true}},
    {"note": "Two scatter sets on the Terrain3D surface. Trees grow on the gentle slopes of the valley, rocks sit on the steep high ground. Both only target the Terrain3D node, so the Godot build stands every instance at the height Terrain3D reports."}
,
    {"tool": "scatter", "args": {"op": "install_models"}},
    {"tool": "scatter", "args": {"op": "new_set", "name": "valley trees", "targets": ["$land.id"], "preset": "mixed woodland"}, "save": "trees"},
    {"tool": "scatter", "args": {"op": "fill", "id": "$trees.id", "density": 0.1, "slope": [0, 28], "height": [-20, 900], "seed": 41, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true}},
    {"tool": "scatter", "args": {"op": "stroke", "id": "$trees.id", "erase": true, "radius": 380, "points": [[-7600, 1400], [-4000, -600], [-500, 900], [2600, -300], [4800, 0], [7600, 0], [10000, 700], [13000, -700], [16000, 300]], "height": null, "only_targets": true}},
    {"tool": "scatter", "args": {"op": "erase", "id": "$trees.id", "center": [4200, -1700], "radius": 1700, "height": null}},
    {"tool": "scatter", "args": {"op": "stroke", "id": "$trees.id", "erase": true, "radius": 260, "points": [[3600, -1700], [4300, -1100], [5400, -1300], [6200, -1300], [6200, 1300], [7600, 2000], [9600, 2300]], "height": null, "only_targets": true}},
    {"tool": "scatter", "args": {"op": "stroke", "id": "$trees.id", "erase": true, "radius": 520, "points": [[16384, 350, 8192], [16384, 350, -8192], [-8192, 350, -8192], [-8192, 350, 8192], [16384, 350, 8192]], "only_targets": true}},
    {"tool": "scatter", "args": {"op": "new_set", "name": "ridge rocks", "targets": ["$land.id"], "preset": "boulders"}, "save": "rocks"},
    {"tool": "scatter", "args": {"op": "fill", "id": "$rocks.id", "density": 0.03, "slope": [8, 60], "height": [500, 3000], "seed": 70, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true}},
    {"note": "Three camera slots: the valley from the west, the village and bridge, and the ridge from the river."}
,
    {"tool": "set_camera", "args": {"view": "3d", "position": [-6400, 2600, 5200], "look_at": [5000, 300, -600]}},
    {"tool": "run_action", "args": {"action": "store_camera", "args": {"slot": 1}}},
    {"tool": "set_camera", "args": {"view": "3d", "position": [4800, 520, 2600], "look_at": [5000, 120, -1200]}},
    {"tool": "run_action", "args": {"action": "store_camera", "args": {"slot": 2}}},
    {"tool": "set_camera", "args": {"view": "3d", "position": [8200, 900, 1200], "look_at": [5600, 500, -5200]}},
    {"tool": "run_action", "args": {"action": "store_camera", "args": {"slot": 3}}},
    {"tool": "run_action", "args": {"action": "select_none"}},
    {"tool": "map_file", "args": {"op": "save", "path": "${save_dir}/terrain3d_valley.tdm"}}
  ]
}
